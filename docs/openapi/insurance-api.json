  "components": {
    "schemas": {
      "ProviderEvent": {
        "type": "object",
        "properties": {
          "tenant_id": {
            "type": "string",
            "format": "uuid"
          },
          "country_code": {
            "type": "string",
            "minLength": 1,
            "pattern": "KE"
          },
          "internal_claim_id": {
            "type": "string",
            "format": "uuid"
          },
          "event_id": {
            "type": "string",
            "format": "uuid"
          },
          "revision": {
            "type": "integer",
            "format": "int64",
            "minimum": 1
          }
        },
        "required": [
          "country_code",
          "event_id",
          "internal_claim_id",
          "tenant_id"
        ]
      },
      "PolicyInput": {
        "type": "object",
        "properties": {
          "customer_id": {
            "type": "string",
            "format": "uuid"
          },
          "policy_number": {
            "type": "string",
            "maxLength": 100,
            "minLength": 0
          },
          "start_date": {
            "type": "string",
            "format": "date"
          },
          "end_date": {
            "type": "string",
            "format": "date"
          },
          "premium": {
            "type": "number",
            "minimum": 0.01
          }
        },
        "required": [
          "customer_id",
          "end_date",
          "policy_number",
          "premium",
          "start_date"
        ]
      },
      "Approval": {
        "type": "object",
        "properties": {
          "evidence_reference": {
            "type": "string",
            "maxLength": 200,
            "minLength": 0
          }
        },
        "required": [
          "evidence_reference"
        ]
      },
      "Notification": {
        "type": "object",
        "properties": {
          "claim_id": {
            "type": "string",
            "format": "uuid"
          },
          "language": {
            "type": "string",
            "minLength": 1,
            "pattern": "en-KE|sw-KE"
          },
          "template_key": {
            "type": "string",
            "minLength": 1,
            "pattern": "claim_received|claim_updated"
          },
          "last_customer_message": {
            "type": "string",
            "format": "date-time"
          },
          "opted_out": {
            "type": "boolean"
          }
        },
        "required": [
          "claim_id",
          "language",
          "last_customer_message",
          "template_key"
        ]
      },
      "TextIntake": {
        "type": "object",
        "properties": {
          "policy_id": {
            "type": "string",
            "format": "uuid"
          },
          "text": {
            "type": "string",
            "maxLength": 20000,
            "minLength": 0
          },
          "language": {
            "type": "string",
            "minLength": 1,
            "pattern": "en-KE|sw-KE"
          }
        },
        "required": [
          "language",
          "policy_id",
          "text"
        ]
      },
      "ClaimView": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "policy_id": {
            "type": "string",
            "format": "uuid"
          },
          "intake_status": {
            "type": "string"
          },
          "provider_claim_status": {
            "type": "string"
          },
          "payout_status": {
            "type": "string"
          },
          "claimant_verified": {
            "type": "boolean"
          },
          "payee_verified": {
            "type": "boolean"
          },
          "extraction": {
            "$ref": "#/components/schemas/Extraction"
          },
          "obligation_id": {
            "type": "string",
            "format": "uuid"
          },
          "amount": {
            "type": "number"
          },
          "currency": {
            "type": "string"
          },
          "provider_kind": {
            "type": "string"
          },
          "provider_revision": {
            "type": "integer",
            "format": "int64"
          }
        }
      },
      "ExtractedInteger": {
        "type": "object",
        "properties": {
          "value": {
            "type": "integer",
            "format": "int32"
          },
          "status": {
            "type": "string",
            "enum": [
              "extracted",
              "confirmed",
              "unverified",
              "missing"
            ]
          },
          "confidence": {
            "type": "number",
            "format": "double",
            "maximum": 1,
            "minimum": 0
          },
          "evidence_span": {
            "type": "string",
            "maxLength": 2000,
            "minLength": 0
          },
          "source": {
            "type": "string",
            "maxLength": 200,
            "minLength": 0
          }
        },
        "required": [
          "status"
        ]
      },
      "ExtractedLocalDate": {
        "type": "object",
        "properties": {
          "value": {
            "type": "string",
            "format": "date"
          },
          "status": {
            "type": "string",
            "enum": [
              "extracted",
              "confirmed",
              "unverified",
              "missing"
            ]
          },
          "confidence": {
            "type": "number",
            "format": "double",
            "maximum": 1,
            "minimum": 0
          },
          "evidence_span": {
            "type": "string",
            "maxLength": 2000,
            "minLength": 0
          },
          "source": {
            "type": "string",
            "maxLength": 200,
            "minLength": 0
          }
        },
        "required": [
          "status"
        ]
      },
      "ExtractedString": {
        "type": "object",
        "properties": {
          "value": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "extracted",
              "confirmed",
              "unverified",
              "missing"
            ]
          },
          "confidence": {
            "type": "number",
            "format": "double",
            "maximum": 1,
            "minimum": 0
          },
          "evidence_span": {
            "type": "string",
            "maxLength": 2000,
            "minLength": 0
          },
          "source": {
            "type": "string",
            "maxLength": 200,
            "minLength": 0
          }
        },
        "required": [
          "status"
        ]
      },
      "Extraction": {
        "type": "object",
        "properties": {
          "schema_version": {
            "type": "string",
            "minLength": 1,
            "pattern": "2"
          },
          "language": {
            "type": "string",
            "minLength": 1,
            "pattern": "en-KE|sw-KE"
          },
          "incident_type_code": {
            "$ref": "#/components/schemas/ExtractedString"
          },
          "hospital_name": {
            "$ref": "#/components/schemas/ExtractedString"
          },
          "admission_date": {
            "$ref": "#/components/schemas/ExtractedLocalDate"
          },
          "discharge_date": {
            "$ref": "#/components/schemas/ExtractedLocalDate"
          },
          "hospital_nights": {
            "$ref": "#/components/schemas/ExtractedInteger"
          },
          "requires_confirmation": {
            "type": "boolean"
          }
        },
        "required": [
          "admission_date",
          "discharge_date",
          "hospital_name",
          "hospital_nights",
          "incident_type_code",
          "language",
          "schema_version"
        ]
      },
      "CustomerInput": {
        "type": "object",
        "properties": {
          "full_name": {
            "type": "string",
            "maxLength": 100,
            "minLength": 0
          },
          "mobile_number": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\+[1-9][0-9]{7,14}"
          }
        },
        "required": [
          "full_name",
          "mobile_number"
        ]
      },
      "Turn": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string",
            "maxLength": 20000,
            "minLength": 0
          },
          "language": {
            "type": "string",
            "minLength": 1,
            "pattern": "en-KE|sw-KE"
          }
        },
        "required": [
          "language",
          "text"
        ]
      },
      "CreateClaim": {
        "type": "object",
        "properties": {
          "policy_id": {
            "type": "string",
            "format": "uuid"
          },
          "extraction": {
            "$ref": "#/components/schemas/Extraction"
          }
        },
        "required": [
          "extraction",
          "policy_id"
        ]
      },
      "Verification": {
        "type": "object",
        "properties": {
          "evidence_reference": {
            "type": "string",
            "maxLength": 200,
            "minLength": 0
          },
          "payee_verified": {
            "type": "boolean"
          }
        },
        "required": [
          "evidence_reference"
        ]
      },
      "Payment": {
        "type": "object",
        "properties": {
          "outcome": {
            "type": "string",
            "minLength": 1,
            "pattern": "CONFIRMED|UNKNOWN"
          }
        },
        "required": [
          "outcome"
        ]
      },
      "Review": {
        "type": "object",
        "properties": {
          "decision": {
            "type": "string",
            "minLength": 1,
            "pattern": "RECOMMEND_APPROVAL|REQUEST_INFORMATION|RECOMMEND_REJECTION"
          },
          "reason_code": {
            "type": "string",
            "maxLength": 100,
            "minLength": 0
          },
          "evidence_reference": {
            "type": "string",
            "maxLength": 200,
            "minLength": 0
          }
        },
        "required": [
          "decision",
          "evidence_reference",
          "reason_code"
        ]
      },
      "Receipt": {
        "type": "object",
        "properties": {
          "outcome": {
            "type": "string",
            "minLength": 1,
            "pattern": "CONFIRMED|FAILED"
          },
          "evidence_reference": {
            "type": "string",
            "maxLength": 200,
            "minLength": 0
          }
        },
        "required": [
          "evidence_reference",
          "outcome"
        ]
      },
      "Evidence": {
        "type": "object",
        "properties": {
          "synthetic_text": {
            "type": "string",
            "maxLength": 20000,
            "minLength": 0
          }
        },
        "required": [
          "synthetic_text"
        ]
      },
      "Resolution": {
        "type": "object",
        "properties": {
          "replacement_id": {
            "type": "string",
            "format": "uuid"
          },
          "evidence_reference": {
            "type": "string",
            "maxLength": 200,
            "minLength": 0
          }
        },
        "required": [
          "evidence_reference",
          "replacement_id"
        ]
      },
      "Correction": {
        "type": "object",
        "properties": {
          "extraction": {
            "$ref": "#/components/schemas/Extraction"
          },
          "evidence_reference": {
            "type": "string",
            "maxLength": 200,
            "minLength": 0
          }
        },
        "required": [
          "evidence_reference",
          "extraction"
        ]
      },
      "Confirmation": {
        "type": "object",
        "properties": {
          "fields": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "evidence_reference": {
            "type": "string",
            "maxLength": 200,
            "minLength": 0
          }
        },
        "required": [
          "evidence_reference",
          "fields"
        ]
      },
      "Process": {
        "type": "object",
        "properties": {
          "policy_id": {
            "type": "string",
            "format": "uuid"
          },
          "language": {
            "type": "string",
            "pattern": "en-KE|sw-KE"
          },
          "fixture_transcript": {
            "type": "string",
            "maxLength": 20000,
            "minLength": 0
          }
        },
        "required": [
          "language",
          "policy_id"
        ]
      }
    }
  }
}
