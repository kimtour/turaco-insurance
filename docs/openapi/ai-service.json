          },
          "provider": {
            "type": "string",
            "title": "Provider"
          },
          "model": {
            "type": "string",
            "title": "Model"
          },
          "prompt_version": {
            "type": "string",
            "title": "Prompt Version"
          },
          "evaluation_status": {
            "type": "string",
            "title": "Evaluation Status"
          },
          "correlation_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Correlation Id"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "trace_id",
          "provider",
          "model",
          "prompt_version",
          "evaluation_status"
        ],
        "title": "ModelTrace"
      },
      "Profile": {
        "properties": {
          "headers": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "maxItems": 40,
            "minItems": 4,
            "title": "Headers"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "headers"
        ],
        "title": "Profile"
      },
      "Turn": {
        "properties": {
          "tenant_id": {
            "type": "string",
            "format": "uuid",
            "title": "Tenant Id"
          },
          "country_code": {
            "type": "string",
            "const": "KE",
            "title": "Country Code"
          },
          "conversation_id": {
            "type": "string",
            "format": "uuid",
            "title": "Conversation Id"
          },
          "language": {
            "type": "string",
            "enum": [
              "en-KE",
              "sw-KE"
            ],
            "title": "Language"
          },
          "text": {
            "type": "string",
            "maxLength": 20000,
            "minLength": 1,
            "title": "Text"
          }
        },
        "type": "object",
        "required": [
          "tenant_id",
          "country_code",
          "conversation_id",
          "language",
          "text"
        ],
        "title": "Turn"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
