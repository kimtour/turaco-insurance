  "components": {
    "schemas": {
      "ClaimExtraction": {
        "properties": {
          "schema_version": {
            "type": "string",
            "const": "2",
            "title": "Schema Version"
          },
          "language": {
            "type": "string",
            "enum": [
              "en-KE",
              "sw-KE"
            ],
            "title": "Language"
          },
          "incident_type_code": {
            "$ref": "#/components/schemas/Extracted_str_"
          },
          "hospital_name": {
            "$ref": "#/components/schemas/Extracted_str_"
          },
          "admission_date": {
            "$ref": "#/components/schemas/Extracted_date_"
          },
          "discharge_date": {
            "$ref": "#/components/schemas/Extracted_date_"
          },
          "hospital_nights": {
            "$ref": "#/components/schemas/Extracted_int_"
          },
          "requires_confirmation": {
            "type": "boolean",
            "const": true,
            "title": "Requires Confirmation"
          },
          "model_trace": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ModelTrace"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "schema_version",
          "language",
          "incident_type_code",
          "hospital_name",
          "admission_date",
          "discharge_date",
          "hospital_nights",
          "requires_confirmation"
        ],
        "title": "ClaimExtraction"
      },
      "DocumentCheck": {
        "properties": {
          "synthetic_text": {
            "type": "string",
            "maxLength": 20000,
            "minLength": 1,
            "title": "Synthetic Text"
          },
          "language": {
            "type": "string",
            "enum": [
              "en-KE",
              "sw-KE"
            ],
            "title": "Language"
          },
          "extraction": {
            "$ref": "#/components/schemas/EvidenceExtraction"
          }
        },
        "type": "object",
        "required": [
          "synthetic_text",
          "language",
          "extraction"
        ],
        "title": "DocumentCheck"
      },
      "EvidenceExtraction": {
        "properties": {
          "schema_version": {
            "type": "string",
            "const": "2",
            "title": "Schema Version"
          },
          "language": {
            "type": "string",
            "enum": [
              "en-KE",
              "sw-KE"
            ],
            "title": "Language"
          },
          "incident_type_code": {
            "$ref": "#/components/schemas/Extracted_str_"
          },
          "hospital_name": {
            "$ref": "#/components/schemas/Extracted_str_"
          },
          "admission_date": {
            "$ref": "#/components/schemas/Extracted_date_"
          },
          "discharge_date": {
            "$ref": "#/components/schemas/Extracted_date_"
          },
          "hospital_nights": {
            "$ref": "#/components/schemas/Extracted_int_"
          },
          "requires_confirmation": {
            "type": "boolean",
            "title": "Requires Confirmation"
          },
          "model_trace": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ModelTrace"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "schema_version",
          "language",
          "incident_type_code",
          "hospital_name",
          "admission_date",
          "discharge_date",
          "hospital_nights",
          "requires_confirmation"
        ],
        "title": "EvidenceExtraction"
      },
      "Extracted_date_": {
        "properties": {
          "value": {
            "anyOf": [
              {
                "type": "string",
                "format": "date"
              },
              {
                "type": "null"
              }
            ],
            "title": "Value"
          },
          "status": {
            "$ref": "#/components/schemas/FieldStatus"
          },
          "confidence": {
            "anyOf": [
              {
                "type": "number",
                "maximum": 1.0,
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Confidence"
          },
          "evidence_span": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Evidence Span"
          },
          "source": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Source"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "value",
          "status",
          "confidence",
          "evidence_span",
          "source"
        ],
        "title": "Extracted[date]"
      },
      "Extracted_int_": {
        "properties": {
          "value": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Value"
          },
          "status": {
            "$ref": "#/components/schemas/FieldStatus"
          },
          "confidence": {
            "anyOf": [
              {
                "type": "number",
                "maximum": 1.0,
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Confidence"
          },
          "evidence_span": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Evidence Span"
          },
          "source": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Source"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "value",
          "status",
          "confidence",
          "evidence_span",
          "source"
        ],
        "title": "Extracted[int]"
      },
      "Extracted_str_": {
        "properties": {
          "value": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Value"
          },
          "status": {
            "$ref": "#/components/schemas/FieldStatus"
          },
          "confidence": {
            "anyOf": [
              {
                "type": "number",
                "maximum": 1.0,
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Confidence"
          },
          "evidence_span": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Evidence Span"
          },
          "source": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Source"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "value",
          "status",
          "confidence",
          "evidence_span",
          "source"
        ],
        "title": "Extracted[str]"
      },
      "ExtractionRequest": {
        "properties": {
          "transcript": {
            "type": "string",
            "maxLength": 20000,
            "minLength": 1,
            "title": "Transcript"
          },
          "language": {
            "type": "string",
            "enum": [
              "en-KE",
              "sw-KE"
            ],
            "title": "Language"
          },
          "incident_catalog": {
            "items": {
              "type": "string",
              "const": "HOSPITALIZATION"
            },
            "type": "array",
            "maxItems": 1,
            "minItems": 1,
            "title": "Incident Catalog"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "transcript",
          "language"
        ],
        "title": "ExtractionRequest"
      },
      "FieldStatus": {
        "type": "string",
        "enum": [
          "extracted",
          "confirmed",
          "unverified",
          "missing"
        ],
        "title": "FieldStatus"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "ModelTrace": {
        "properties": {
          "trace_id": {
            "type": "string",
