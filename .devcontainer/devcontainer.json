{
  "name": "Turaco cloud presentation",
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {},
    "ghcr.io/devcontainers/features/sshd:1": {}
  },
  "hostRequirements": {
    "cpus": 2,
    "memory": "4gb",
    "storage": "32gb"
  },
  "forwardPorts": [
    5173
  ],
  "portsAttributes": {
    "5173": {
      "label": "Turaco live synthetic demo",
      "onAutoForward": "silent",
      "protocol": "http"
    }
  },
  "postCreateCommand": "bash .devcontainer/start-demo.sh --build",
  "postStartCommand": "bash .devcontainer/start-demo.sh",
  "remoteUser": "vscode",
  "build": {
    "dockerfile": "Dockerfile"
  }
}
