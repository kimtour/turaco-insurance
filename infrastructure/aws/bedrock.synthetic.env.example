# Selected synthetic pilot defaults. Source into an approved environment only.
# No account credentials are included; mock/offline operation remains enabled.
AI_PROVIDER=mock
MAPPING_PROVIDER=mock
REAL_PROVIDER_ENABLED=false
BEDROCK_ENABLED=false
BEDROCK_REGION=eu-west-1
BEDROCK_ALLOWED_REGIONS=eu-west-1
BEDROCK_MODEL_ID=openai.gpt-oss-20b-1:0
BEDROCK_ALLOWED_MODEL_IDS=openai.gpt-oss-20b-1:0
# Conservative budget assumptions, NOT quoted AWS prices. Review before live use.
BEDROCK_INPUT_USD_PER_MILLION=1
BEDROCK_OUTPUT_USD_PER_MILLION=3
BEDROCK_MAX_REQUEST_USD=0.15
