{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "turaco-presentation",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-16",
  "workers_dev": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/workspace",
      "/workspace/*",
      "/assets/*",
      "/api/*",
      "/demo/*",
      "/downloads/*"
    ]
  },
  "observability": {
    "enabled": false
  },
  "vars": {
    "BACKEND_ORIGIN": "https://turaco-interview-presentation-gjpx5g4p543wj5q-5173.app.github.dev",
    "CODESPACE_URL": "https://github.com/codespaces/turaco-interview-presentation-gjpx5g4p543wj5q",
    "REFERENCE_COMMIT": "24935a7ff5d69cb677d0444927970da8a0695218"
  }
}
