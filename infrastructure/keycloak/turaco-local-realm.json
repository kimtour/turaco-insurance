{
  "realm": "turaco-local",
  "enabled": true,
  "displayName": "LOCAL SYNTHETIC ONLY",
  "sslRequired": "none",
  "registrationAllowed": false,
  "roles": {
    "realm": [
      {
        "name": "claims:read"
      },
      {
        "name": "claims:write"
      },
      {
        "name": "claims:review"
      },
      {
        "name": "claims:approve"
      },
      {
        "name": "claims:pay"
      }
    ]
  },
  "clients": [
    {
      "clientId": "claims-local",
      "publicClient": true,
      "directAccessGrantsEnabled": true,
      "standardFlowEnabled": false,
      "webOrigins": [
        "http://localhost:5173"
      ],
      "protocolMappers": [
        {
          "name": "tenant_id",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "config": {
            "user.attribute": "tenant_id",
            "claim.name": "tenant_id",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "true"
          }
        },
        {
          "name": "country_code",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "config": {
            "user.attribute": "country_code",
            "claim.name": "country_code",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "true"
          }
        },
        {
          "name": "audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "insurance-api",
            "access.token.claim": "true"
          }
        }
      ],
      "defaultClientScopes": [
        "basic",
        "roles",
        "profile"
      ]
    }
  ],
  "users": [
    {
      "username": "officer",
      "enabled": true,
      "firstName": "Synthetic",
      "lastName": "officer",
      "email": "officer@example.invalid",
      "emailVerified": true,
      "attributes": {
        "tenant_id": [
          "11111111-1111-1111-1111-111111111111"
        ],
        "country_code": [
          "KE"
        ]
      },
      "credentials": [
        {
          "type": "password",
          "value": "local-demo-only",
          "temporary": false
        }
      ],
      "realmRoles": [
        "claims:read",
        "claims:write"
      ]
    },
    {
      "username": "reviewer",
      "enabled": true,
      "firstName": "Synthetic",
      "lastName": "reviewer",
      "email": "reviewer@example.invalid",
      "emailVerified": true,
      "attributes": {
        "tenant_id": [
          "11111111-1111-1111-1111-111111111111"
        ],
        "country_code": [
          "KE"
        ]
      },
      "credentials": [
        {
          "type": "password",
          "value": "local-demo-only",
          "temporary": false
        }
      ],
      "realmRoles": [
        "claims:read",
        "claims:review"
      ]
    },
    {
      "username": "approver",
      "enabled": true,
      "firstName": "Synthetic",
      "lastName": "approver",
      "email": "approver@example.invalid",
      "emailVerified": true,
      "attributes": {
        "tenant_id": [
          "11111111-1111-1111-1111-111111111111"
        ],
        "country_code": [
          "KE"
        ]
      },
      "credentials": [
        {
          "type": "password",
          "value": "local-demo-only",
          "temporary": false
        }
      ],
      "realmRoles": [
        "claims:read",
        "claims:write",
        "claims:review",
        "claims:approve",
        "claims:pay"
      ]
    }
  ]
}
